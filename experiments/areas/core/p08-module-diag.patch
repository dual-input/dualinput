+// p08's diagnostic patch: the connection's handle for the freeze through SimConnect, and the
+// mode the probe writes, 0 for fsEventsTriggerKeyEvent and 1 for SimConnect.
+pub(crate) static P08_HANDLE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub(crate) static P08_MODE: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+// Words 16 to 28 of the report: exceptions, which mode area delivered, client data heard, and
+// the send IDs of the calls an exception could name.
+pub(crate) static P08_WORDS: [std::sync::atomic::AtomicU32; 16] = [const { std::sync::atomic::AtomicU32::new(0) }; 16];
+const P08_MODE_HIGH: u32 = 0xD000;
+fn p08_add(i: usize, by: u32) {
+    if let Some(w) = P08_WORDS.get(i) {
+        w.fetch_add(by, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+fn p08_set(i: usize, v: u32) {
+    if let Some(w) = P08_WORDS.get(i) {
+        w.store(v, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+fn p08_send_id(handle: HANDLE) -> u32 {
+    let mut id: DWORD = 0;
+    // SAFETY: SimConnect writes the ID into `id`, which outlives the call.
+    unsafe { crate::bindings::SimConnect_GetLastSentPacketID(handle, &mut id) };
+    id as u32
