diff --git a/src/sim-package/wasm-module/src/aircraft.rs b/src/sim-package/wasm-module/src/aircraft.rs
index 42f5a3c..2227381 100644
--- a/src/sim-package/wasm-module/src/aircraft.rs
+++ b/src/sim-package/wasm-module/src/aircraft.rs
@@ -99,6 +99,60 @@ pub(crate) struct Aircraft {
     ids: Option<FreezeIds>,
     /// Each preset's ID, by its name, which a reset of the sim's variables drops.
     presets: BTreeMap<String, FsBVarId>,
+    /// p32's last `L:DUALINPUT_P32_GO` (experiments/areas/sync/p32-presets/presets.patch, never committed).
+    p32_go: f64,
+}
+
+impl Aircraft {
+    /// p32: when `L:DUALINPUT_P32_GO` changes, calls the preset `L:DUALINPUT_P32_PRESET` picks
+    /// with `L:DUALINPUT_P32_VALUE`, through `call_preset` as state sync's routine does, and
+    /// writes the go's value into `L:DUALINPUT_P32_DONE`.
+    pub(crate) fn p32(&mut self) {
+        let go = p32_number("(L:DUALINPUT_P32_GO, number)");
+        if go == self.p32_go {
+            return;
+        }
+        self.p32_go = go;
+        let names = [
+            "INSTRUMENT_Heading_Bug_Set",
+            "INSTRUMENT_Altimeter_1_Set",
+            "LANDING_GEAR_ParkingBrake_Set",
+            "PASSENGER_Cabin_Heat_2_Set",
+            "LANDING_GEAR_Gear_Set",
+            "INSTRUMENT_Altimeter_2_Set",
+            "PASSENGER_Cabin_Heat_3_Set",
+        ];
+        let index = p32_number("(L:DUALINPUT_P32_PRESET, number)");
+        let Some(name) = names
+            .iter()
+            .enumerate()
+            .find(|(i, _)| *i as f64 == index)
+            .map(|(_, name)| *name)
+        else {
+            return;
+        };
+        let value = p32_number("(L:DUALINPUT_P32_VALUE, number)");
+        // `L:DUALINPUT_P32_ROUTE` 1 calls it as calculator code, as FS Copilot's module does.
+        if p32_number("(L:DUALINPUT_P32_ROUTE, number)") == 1.0 {
+            p32_number(&format!("{value} (>B:{name})"));
+        } else {
+            self.call_preset(name, Some(value));
+        }
+        p32_number(&format!("{go} (>L:DUALINPUT_P32_DONE, number)"));
+    }
+}
+
+/// Runs p32's calculator code and gives its number, 0 when it gives none.
+fn p32_number(code: &str) -> f64 {
+    let Ok(code) = CString::new(code) else {
+        return 0.0;
+    };
+    let mut value = 0.0;
+    // SAFETY: the sim reads the code, which outlives the call, and writes one number.
+    unsafe {
+        execute_calculator_code(code.as_ptr(), &mut value, ptr::null_mut(), ptr::null_mut())
+    };
+    value
 }
 
