+
+/// p04: how long each part of the module's update took, over a window of frames, as `L:`
+/// variables experiments/areas/traffic-atc/p04-traffic-time/parts.mjs reads, in ns:
+/// DUALINPUT_P04_<PART>_P50 and _P99 for each of `PARTS`, and DUALINPUT_P04_WINDOW, which
+/// counts windows. The sim's WASM Debug window reads 0ms for a standalone module
+/// (record/areas/core/log.md, 2026-10-21), so this is the one way we have to time it.
+const PARTS: [&str; 5] = ["WHOLE", "TAKE", "TRAFFIC", "OTHERS", "WRITES"];
+
+struct Timer {
+    took: [Vec<u64>; 5],
+    ids: Option<(Vec<routine_host::Ids>, routine_host::Ids)>,
+    windows: u64,
+}
+
+impl Timer {
+    const FRAMES: usize = 300;
+
+    fn add(&mut self, parts: [u64; 5]) {
+        for (list, took) in self.took.iter_mut().zip(parts) {
+            list.push(took);
+        }
+        if self.took.first().map_or(0, Vec::len) < Self::FRAMES {
+            return;
+        }
+        if self.ids.is_none() {
+            let id = |name: String| {
+                vars::look_up(
+                    0,
+                    &routine_host::Named {
+                        space: routine_host::Space::L,
+                        name,
+                        unit: "number".to_string(),
+                    },
+                )
+            };
+            let parts: Option<Vec<_>> = PARTS
+                .iter()
+                .flat_map(|p| [format!("DUALINPUT_P04_{p}_P50"), format!("DUALINPUT_P04_{p}_P99")])
+                .map(id)
+                .collect();
+            if let (Some(parts), Some(window)) = (parts, id("DUALINPUT_P04_WINDOW".to_string())) {
+                self.ids = Some((parts, window));
+            }
+        }
+        self.windows += 1;
+        let mut values = Vec::new();
+        for list in &mut self.took {
+            list.sort_unstable();
+            let at = |share: usize| {
+                list.get(share * (Self::FRAMES - 1) / 100)
+                    .copied()
+                    .unwrap_or(0) as f64
+            };
+            values.push(at(50));
+            values.push(at(99));
+            list.clear();
+        }
+        if let Some((parts, window)) = &self.ids {
+            for (ids, value) in parts.iter().zip(values) {
+                vars::set(0, routine_host::Space::L, *ids, value);
+            }
+            vars::set(0, routine_host::Space::L, *window, self.windows as f64);
+        }
+    }
+}
+
+thread_local! {
+    static TIMER: RefCell<Timer> = const {
+        RefCell::new(Timer {
+            took: [Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new()],
+            ids: None,
+            windows: 0,
+        })
+    };
+}
+
+fn clock_ns() -> u64 {
+    const MONOTONIC: u32 = 1;
+    let mut ns = 0;
+    // SAFETY: the sim writes the time into `ns`, which outlives the call.
+    unsafe { clock_time_get(MONOTONIC, 1, &mut ns) };
+    ns
 }
 
