// The extension runs in VS Code's extension host, on Node, and esbuild bundles src/extension.ts
// into one CommonJS file, while Node's test runner runs the tests beside it by stripping their
// types, so `erasableSyntaxOnly` flags what Node can't strip, such as an enum. VS Code 1.91, the
// lowest that package.json's `engines` takes, runs Node 20, hence ES2022.
//
// src/package.json marks src/ as ES modules, for Node running the tests and for this check. The
// manifest a folder up names no `type`, since VS Code 1.91 loads `main` with `require`.
//
// vscode-oniguruma's declarations, which the grammar's test uses, name `WebAssembly`'s types,
// which only the DOM's library declares, so the check skips libraries' declarations rather than
// take in the DOM, which the extension host lacks.
{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
