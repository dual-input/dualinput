// The backend's Worker (record/areas/network/02-units.md, "The backend"). tools/backend.ts
// deploys it with this file, D1's migrations and then `wrangler deploy`, from the release
// workflow and the backend's own (record/areas/build/01-the-build.md, "The backend"), and the
// bench and the backend's tests run it locally, through `wrangler dev --local`, on a local D1.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dualinput-backend",
  "main": "src/index.ts",
  // The newest date the workerd that wrangler 4.152.0 runs locally knows, 1.20261019.1.
  "compatibility_date": "2026-10-19",
  // BACKEND_URL in src/platform/network/src/backend.rs names the same host, so change both
  // together.
  "routes": [{ "pattern": "api.dualinput.app", "custom_domain": true }],
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dualinput",
      // The database `wrangler d1 create` made in Cloudflare, once, by hand, since a deploy
      // makes none; local runs key their own database by the same ID.
      "database_id": "fa54a58e-a88b-4f41-af27-f3caee8e63db",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
