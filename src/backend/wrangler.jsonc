// The backend's Worker (record/areas/network/02-units.md, "The backend"). The release
// workflow runs D1's migrations and then `wrangler deploy` with this file
// (record/areas/build/01-the-build.md, "A release"); until then the bench and the backend's
// tests run it locally, through `wrangler dev --local`, on a local D1.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dualinput-backend",
  "main": "src/index.ts",
  // The newest date the workerd that wrangler 4.152.0 runs locally knows, 1.20261019.1.
  "compatibility_date": "2026-10-19",
  // BACKEND_URL in src/platform/network/src/backend.rs names the same host, so change both
  // together.
  "routes": [{ "pattern": "api.dualinput.app", "custom_domain": true }],
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dualinput",
      // A placeholder, which local runs key their database by: the release's first deploy
      // creates the database in Cloudflare and writes its real ID here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
