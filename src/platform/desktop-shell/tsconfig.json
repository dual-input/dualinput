// The desktop app's window runs in WebView2, a current Chromium, so this checks it against what that has. It still draws
// with the kit, which keeps to what Coherent GT runs.
{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": []
  },
  "include": ["src", "dev"]
}
